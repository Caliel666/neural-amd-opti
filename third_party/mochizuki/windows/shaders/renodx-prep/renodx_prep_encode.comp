#version 460
#extension GL_EXT_samplerless_texture_functions : require
// RenoDX's v6 encode (v6_encode.cs_5_1.hlsl) for a frame Preprocess has already put through its own display
// curve ([Preprocess] Curve other than none): the same area footprint onto the network's extent and the same sRGB
// encode, without RenoDX's shadow toe and highlight shoulder, so the frame is not given two curves. Divisor 1.
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) uniform texture2D Original;   // Preprocess's output at the frame's extent
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D Output;   // the proxy
layout(push_constant) uniform Push { uvec2 size, source_size; } pc;

vec3 srgb_encode(vec3 c) {   // codec_math.hlsli SrgbEncode
    c = clamp(c, 0.0, 1.0);
    return mix(1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, c * 12.92, lessThanEqual(c, vec3(0.0031308)));
}

void main() {
    const uvec2 pixel = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(pixel, pc.size))) return;
    const uvec2 source_size = max(pc.source_size, uvec2(1u));
    const vec2 scale = vec2(source_size) / vec2(pc.size);
    const vec2 center = (vec2(pixel) + 0.5) * scale;
    const vec2 footprint_min = max(center - 0.5 * scale, vec2(0.0));
    const vec2 footprint_max = min(center + 0.5 * scale, vec2(source_size));
    const ivec2 first = ivec2(floor(footprint_min));
    const ivec2 last = ivec2(ceil(footprint_max));
    vec3 sum = vec3(0.0);
    float weight = 0.0;
    for (int y = first.y; y < last.y; ++y) {
        for (int x = first.x; x < last.x; ++x) {
            const vec2 overlap = min(vec2(x + 1, y + 1), footprint_max) - max(vec2(x, y), footprint_min);
            const float w = max(overlap.x, 0.0) * max(overlap.y, 0.0);
            const vec3 texel = texelFetch(Original, ivec2(x, y), 0).rgb;
            const uvec3 bits = floatBitsToUint(texel) & 0x7F800000u;
            sum += mix(texel, mix(vec3(0.0), vec3(65504.0), greaterThan(texel, vec3(0.0))), equal(bits, uvec3(0x7F800000u))) * w;
            weight += w;
        }
    }
    const vec3 proxy = weight > 0.0 ? max(sum / weight, vec3(0.0)) : vec3(0.0);
    imageStore(Output, ivec2(pixel), vec4(srgb_encode(proxy), 1.0));
}
