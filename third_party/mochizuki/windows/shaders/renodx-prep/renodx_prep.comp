#version 460
#extension GL_GOOGLE_include_directive : require
// Preprocess ([Preprocess] in dlssnr-amd.ini) with the RenoDX-style option ([RenoDX], linux/src/core/nr_renodx.cpp).
// The same math as runtime_prep.comp (prep_math.glsl), placed around RenoDX's processing:
//
//   linear HDR (RenoDX's v6 codec): the frame x before RenoDX's encode becomes forward(x) (mode 1: a -> b); RenoDX's
//     encode then reads that, and its resolve multiplies the untouched x by the network's N/P, which takes every
//     change made here out again - nothing to undo.
//   SDR (RenoDX's legacy codec, which takes the network's answer whole): as runtime_prep.comp on the network's input
//     in place, P kept (mode 1: a in place, b = P), and the change taken back out of the answer (mode 2: a the
//     network's input, b = P, c the answer; RESTORE puts P back into a for what follows).
//
// Mode 0 meters `a` (one workgroup), as runtime_prep.comp's meter().
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, std430) buffer State { float s[4]; } st;   // smoothed log2 gain, valid, gain, target
layout(set = 0, binding = 1, rgba16f) uniform image2D a;
layout(set = 0, binding = 2, rgba16f) uniform image2D b;
layout(set = 0, binding = 3, rgba16f) uniform image2D c;
layout(push_constant) uniform Push {
    uint width, height, mode, flags, curve;
    float bias, contrast, saturation, k, cap;
    float dt;
} pc;

const uint AUTO = 1u, UNKNEE = 2u, RESTORE = 4u, RESET = 8u, LINEAR = 16u;
const vec3 LUMA = vec3(0.2126, 0.7152, 0.0722);

// The frame's encoding: sRGB for an SDR frame, none for RenoDX's linear work surface (LINEAR).
vec3 enc(vec3 v) {
    v = clamp(v, 0.0, 1.0);
    return mix(v * 12.92, 1.055 * pow(max(v, vec3(1e-8)), vec3(1.0 / 2.4)) - 0.055, step(0.0031308, v));
}
vec3 dec(vec3 v) {
    v = clamp(v, 0.0, 1.0);
    return mix(v / 12.92, pow((v + 0.055) / 1.055, vec3(2.4)), step(0.04045, v));
}
// Never set here (runtime_prep.comp's OptiScaler soft knee); kept so the shared math reads the same.
vec3 knee(vec3 d) { return d; }
vec3 knee_inv(vec3 d) { return d; }
bool unknee() { return false; }
bool linear_frame() { return (pc.flags & LINEAR) != 0u; }
vec3 light(vec3 P) { return linear_frame() ? max(P, vec3(0.0)) : dec(P); }
vec3 reencode(vec3 v) { return linear_frame() ? v : enc(v); }

#include "prep_math.glsl"

void main() {
    if (pc.mode == 0u) { meter(); return; }
    const ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    if (xy.x >= int(pc.width) || xy.y >= int(pc.height)) return;
    if (pc.mode == 1u) {
        const vec4 P = imageLoad(a, xy);
        if (linear_frame()) {
            imageStore(b, xy, finite(P.rgb) ? vec4(forward(light(P.rgb)), P.a) : P);
            return;
        }
        imageStore(b, xy, P);
        if (!finite(P.rgb)) return;
        imageStore(a, xy, vec4(enc(forward(light(P.rgb))), P.a));
        return;
    }
    const vec4 nin = imageLoad(a, xy), nout = imageLoad(c, xy), P = imageLoad(b, xy);
    vec3 M = P.rgb;
    if (nout.rgb != nin.rgb && finite(nout.rgb) && finite(P.rgb)) {
        const vec3 din = dec(nin.rgb), dout = dec(nout.rgb);
        vec3 d = backward(dout) - backward(din);
        const vec3 lim = pc.cap * abs(dout - din) / gain();
        d = clamp(d, -lim, lim);
        const vec3 p = light(P.rgb);
        M = max(P.rgb + reencode(max(p + d, vec3(0.0))) - reencode(p), vec3(0.0));
        if (!finite(M)) M = P.rgb;
    }
    imageStore(c, xy, vec4(M, nout.a));
    if ((pc.flags & RESTORE) != 0u) imageStore(a, xy, P);
}
