#version 460
// Pass 3 estimated (Controls::pass3_estimate), step 1 of 2, after lmxxf's
// multi_pass_predict.hip: per 16x16 tile, how much of pass 2's change the third
// pass would repeat. a = pass 1's change (y1 - x), b = pass 2's (y2 - y1);
// r = <a,b> / <a,a>, in 0..1, and 0 where the two do not point the same way
// (ab <= 0, or a correlation under one half). One workgroup per tile.
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0) uniform sampler2D shown;                   // x: the first pass's input
layout(set = 0, binding = 1, rgba32f) uniform readonly image2D first;   // y1
layout(set = 0, binding = 2, rgba32f) uniform readonly image2D second;  // y2 (surf0)
layout(set = 0, binding = 3, r32f) uniform writeonly image2D gain;      // one texel per tile
layout(push_constant) uniform Push { uint width, height; } pc;
shared float sa[256], sb[256], sab[256];
void main() {
    const ivec2 xy = ivec2(gl_GlobalInvocationID.xy);
    const uint i = gl_LocalInvocationIndex;
    float aa = 0.0, bb = 0.0, ab = 0.0;
    if (xy.x < int(pc.width) && xy.y < int(pc.height)) {
        const vec3 x = clamp(texelFetch(shown, xy, 0).rgb, vec3(0.0), vec3(1.0));
        const vec3 y1 = imageLoad(first, xy).rgb, y2 = imageLoad(second, xy).rgb;
        const vec3 a = y1 - x, b = y2 - y1;
        aa = dot(a, a);
        bb = dot(b, b);
        ab = dot(a, b);
    }
    sa[i] = aa;
    sb[i] = bb;
    sab[i] = ab;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1) {
        if (i < s) {
            sa[i] += sa[i + s];
            sb[i] += sb[i + s];
            sab[i] += sab[i + s];
        }
        barrier();
    }
    if (i == 0u) {
        const float eps = 256.0e-7;
        aa = sa[0]; bb = sb[0]; ab = sab[0];
        float r = 0.0;
        if (aa >= eps && ab > 0.0 && ab * ab >= 0.25 * aa * bb) r = clamp(ab / (aa + eps), 0.0, 1.0);
        imageStore(gain, ivec2(gl_WorkGroupID.xy), vec4(r, 0.0, 0.0, 0.0));
    }
}
